# Optional local deployment settings. Copy this to .env before the first start.
RELAY_PUBLIC_URL=http://localhost:8080
RELAY_BIND_ADDRESS=127.0.0.1
RELAY_HTTP_PORT=8080
RELAY_ADMIN_EMAIL=admin@example.invalid
# A remote caller needs a reachable TURN address and the documented UDP ports.
RELAY_TURN_URL=turn:127.0.0.1:3478?transport=udp
