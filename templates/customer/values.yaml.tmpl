customer:
  slug: "{{CUSTOMER_SLUG}}"
  region: "{{AWS_REGION}}"
  appHost: "{{DOMAIN_NAME}}"
  authHost: "{{DOMAIN_NAME}}"

images:
  relay:
    repository: "{{ECR_REGISTRY}}/{{CUSTOMER_SLUG}}/relay-server"
    digest: "{{SERVER_IMAGE_DIGEST}}"
  keycloak:
    repository: "{{ECR_REGISTRY}}/{{CUSTOMER_SLUG}}/relay-keycloak"
    digest: "{{KEYCLOAK_IMAGE_DIGEST}}"

serviceAccounts:
  relay:
    annotations: {}
  keycloak:
    annotations: {}

secrets:
  clusterSecretStore: aws-secrets-manager
  relayRuntimeSecretArn: "__TF_OUTPUT_RELAY_RUNTIME_SECRET_ARN__"
  keycloakRuntimeSecretArn: "__TF_OUTPUT_KEYCLOAK_RUNTIME_SECRET_ARN__"

database:
  host: "{{DATABASE_HOST}}"
  port: 5432
  relayDatabase: relay
  relayUsername: relay_app
  keycloakDatabase: keycloak
  keycloakUsername: keycloak_app
  caBundleUrl: "https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem"
  caBundleSha256: "e5bb2084ccf45087bda1c9bffdea0eb15ee67f0b91646106e466714f9de3c7e3"

storage:
  mediaBucket: "__TF_OUTPUT_MEDIA_BUCKET__"
  region: "{{AWS_REGION}}"

relay:
  replicaCount: {{RELAY_REPLICAS}}
  scaleReady: {{SCALE_READY_RELEASE}}
  sessionAudience: relay-api
  sessionTtlSeconds: 604800
  resources:
    requests: { cpu: 500m, memory: 1Gi, ephemeral-storage: 2Gi }
    limits: { cpu: "2", memory: 3Gi, ephemeral-storage: 8Gi }
  podAnnotations: {}

keycloak:
  replicaCount: {{KEYCLOAK_REPLICAS}}
  realm: relay
  registrationAllowed: true
  # Turn on only after customer SMTP/SES delivery has been validated.
  emailVerificationEnabled: false
  resources:
    requests: { cpu: 750m, memory: 1536Mi }
    limits: { cpu: "2", memory: 3Gi }
  podAnnotations: {}

service:
  relayNodePort: 30080
  keycloakNodePort: 30081

autoscaling:
  # Fixed, tier-sized replicas are deliberate: load-test certification and a
  # separately reviewed autoscaling policy are required before enabling HPA.
  enabled: false
  minReplicas: {{RELAY_REPLICAS}}
  maxReplicas: {{RELAY_REPLICAS}}
  targetCPUUtilizationPercentage: 65

podDisruptionBudget:
  keycloakMinAvailable: 1

nodeSelector: {}
tolerations: []
affinity: {}
