name: relay-{{CUSTOMER_SLUG}}

services:
  relay:
    image: "{{ECR_REGISTRY}}/{{CUSTOMER_SLUG}}/relay-server@{{SERVER_IMAGE_DIGEST}}"
    restart: unless-stopped
    env_file:
      - /run/relay/server.env
    environment:
      NODE_ENV: production
      PORT: "3001"
      TRUST_PROXY: "1"
      NODE_EXTRA_CA_CERTS: /etc/relay/rds-global-bundle.pem
    ports:
      - "3001:3001"
    read_only: true
    tmpfs:
      - /tmp:size=256m,mode=1777
      - /app/uploads:size=1g,mode=0750,uid=1000,gid=1000
    volumes:
      - /etc/relay/rds-global-bundle.pem:/etc/relay/rds-global-bundle.pem:ro
    security_opt:
      - no-new-privileges:true
    cap_drop: ["ALL"]
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:3001/api/health').then(response => process.exit(response.ok ? 0 : 1), () => process.exit(1))"]
      interval: 15s
      timeout: 5s
      retries: 8
    logging:
      driver: awslogs
      options:
        awslogs-region: "{{AWS_REGION}}"
        awslogs-group: "/relay/{{CUSTOMER_SLUG}}/application"
        awslogs-stream: relay

  keycloak:
    image: "{{ECR_REGISTRY}}/{{CUSTOMER_SLUG}}/relay-keycloak@{{KEYCLOAK_IMAGE_DIGEST}}"
    restart: unless-stopped
    command: ["start", "--import-realm", "--proxy-headers=xforwarded", "--http-enabled=true"]
    env_file:
      - /run/relay/keycloak.env
    environment:
      KC_HTTP_RELATIVE_PATH: "/auth"
      KC_HOSTNAME: "{{PUBLIC_ORIGIN}}/auth"
      KC_HTTP_ENABLED: "true"
      KC_PROXY_HEADERS: xforwarded
      KC_DB_URL_PROPERTIES: "?sslmode=verify-full&sslrootcert=/etc/relay/rds-global-bundle.pem"
    ports:
      - "8080:8080"
    volumes:
      - keycloak-data:/opt/keycloak/data
      - keycloak-quarkus:/opt/keycloak/lib/quarkus
      - /opt/relay/keycloak/realm:/opt/keycloak/data/import:ro
      - /etc/relay/rds-global-bundle.pem:/etc/relay/rds-global-bundle.pem:ro
    # Quarkus augmentation is confined to the image-digest-specific volume;
    # Docker seeds it from the immutable image before the read-only start.
    read_only: true
    tmpfs:
      - /tmp:size=256m,mode=1777
    security_opt:
      - no-new-privileges:true
    cap_drop: ["ALL"]
    logging:
      driver: awslogs
      options:
        awslogs-region: "{{AWS_REGION}}"
        awslogs-group: "/relay/{{CUSTOMER_SLUG}}/application"
        awslogs-stream: keycloak

volumes:
  keycloak-data:
  keycloak-quarkus:
    name: "relay-{{CUSTOMER_SLUG}}-keycloak-quarkus-{{KEYCLOAK_IMAGE_ID}}"
